





# imports
import numpy as np
from scipy.io import arff
import pandas as pd





from sklearn.linear_model import Perceptron

Data_Set = arff.loadarff('linsep2nonorigin.arff')
Data_Set_df = pd.DataFrame(Data_Set[0])
Data_Set_np = Data_Set_df.to_numpy()
Data_Set_np = Data_Set_np.astype(float)
X = Data_Set_np[:, :-1]
y = Data_Set_np[:, -1]
print(X)
print(y)

clf = Perceptron(shuffle=False, verbose=1, eta0=.1, max_iter=10)
clf.fit(X, y)
print(clf.coef_)
print(clf.intercept_)
print(clf.score(X, y))








